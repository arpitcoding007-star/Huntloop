# Copy to apps/web/.env.local and fill in. Never commit the filled version.

# ── Supabase ────────────────────────────────────────────────────────────
# Project ref: hnoycsbdddpmsivtmrws
# Current-generation key names (Supabase's publishable/secret system,
# successor to the legacy anon/service_role JWTs).
NEXT_PUBLIC_SUPABASE_URL=https://hnoycsbdddpmsivtmrws.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy aliases, read as a fallback by packages/db/src/env.ts for projects
# created before Supabase renamed these keys. Set the current-generation names
# above instead; these are listed only so the pair is discoverable.
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY       → SUPABASE_SECRET_KEY

# Server-only. Bypasses RLS — never expose to the browser, never prefix with
# NEXT_PUBLIC_. Used exclusively by packages/db/src/admin.ts (plan §D2).
SUPABASE_SECRET_KEY=

# Direct Postgres connection — separate from the two keys above, and the only
# one that can CREATE TABLE. The keys talk to Supabase's web API, which reads
# and writes rows and cannot change the schema; without this, migrations have
# to be pasted into the dashboard's SQL editor by hand (SETUP.md step 3).
#
# Also what `EXPLAIN ANALYZE` needs — PostgREST will not return a query plan,
# so PERF-04 cannot start until this is set.
#
# Supabase dashboard → Project Settings → Database → Connection string
# ("Transaction" pooler mode for serverless/Vercel). Replace [YOUR-PASSWORD]
# with the database password from when the project was created.
DATABASE_URL=

# ── Site ────────────────────────────────────────────────────────────────
# The public origin, used for canonical URLs, Open Graph tags, robots.txt and
# sitemap.xml. Set it in production: without it these fall back to the
# per-deployment Vercel host, or to localhost in development.
NEXT_PUBLIC_SITE_URL=

# Topbar destinations. Both optional, and deliberately empty here: the Feedback
# link and the Help button are only rendered when they have somewhere to go.
# Until then no control appears, which is the honest state — they were
# previously hardcoded to "#" and looked live while doing nothing.
NEXT_PUBLIC_FEEDBACK_URL=
NEXT_PUBLIC_HELP_URL=

# Shows "Continue with Google" on /login and /signup when exactly "true".
# Turn the Google provider on in Supabase (Authentication → Providers) first,
# with <NEXT_PUBLIC_SITE_URL>/auth/callback as an allowed redirect URL, or
# every click lands on /login?error=oauth.
NEXT_PUBLIC_AUTH_GOOGLE=

# ── Security ────────────────────────────────────────────────────────────
# Content-Security-Policy enforcement. Unset or anything other than "true"
# ships the policy as Content-Security-Policy-Report-Only: violations are sent
# to /api/csp-report and on to Sentry, and nothing is blocked.
#
# Leave it off until that report stream has been quiet for a week. A wrong CSP
# does not fail loudly — it blocks one script on one route and the page
# half-works, which is why this has a switch at all.
CSP_ENFORCE=

# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Milliseconds before one model request is abandoned. Default 55000 — just under
# a 60 s function limit. Raise only on a plan that allows longer functions.
HUNTLOOP_AI_TIMEOUT_MS=

# ── Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Stored credentials (mailbox OAuth, and now CRM) ─────────────────────
#
# 32 bytes, hex. Encrypts every column holding somebody else's credential at
# the application layer: mailboxes.oauth_token_enc and refresh_token_enc, and
# hubspot_connections.access_token. Those are the customer's credentials, not
# ours, and they leave a database through backups, snapshots and log lines
# without anyone breaching it. Connecting a mailbox or a CRM is refused when
# this is unset, rather than storing a token in plain text.
#
#   openssl rand -hex 32
#
# The name is narrower than the use: it predates the CRM integration and is
# kept because renaming a variable that is already set on live deployments
# trades a real outage for a tidier name. One key for every stored credential
# is deliberate — a second key would double the operational burden of rotation
# and protect nothing the first one does not.
#
# Rotating it makes every connected mailbox and CRM need reconnecting.
MAILBOX_ENCRYPTION_KEY=

# Google Cloud console → OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/mailboxes/gmail/callback
# Scopes used: gmail.send, gmail.readonly, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entra ID → App registration. Redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/mailboxes/outlook/callback
# Scopes used: Mail.Send, Mail.Read, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Product email (Resend) ──────────────────────────────────────────────
#
# The product's own mail: invitations, join-request notices to admins,
# approvals, and the daily "Needs you" summary. Prospect outreach never goes
# through here — it is sent from each customer's connected mailbox.
#
# Resend dashboard → API Keys (sending access is enough), and Domains → add
# and verify the domain in EMAIL_FROM (SPF + DKIM records at your DNS host).
# Both must be set or nothing is sent; /api/health reports which.
RESEND_API_KEY=
# A verified sender, e.g. "Huntloop <notifications@yourdomain.com>".
EMAIL_FROM=
# Optional. Where replies to product email go, e.g. support@yourdomain.com.
EMAIL_REPLY_TO=
#
# Sign-in links are sent by Supabase Auth, not by this app. To send them
# through Resend too (and lift Supabase's built-in 2-per-hour limit), set
# Supabase → Authentication → SMTP Settings to:
#   host smtp.resend.com · port 465 · user "resend" · password = a Resend API key
#   sender = the same verified address as EMAIL_FROM

# ── Jobs ────────────────────────────────────────────────────────────────
#
# The engine ticks from /api/jobs/tick, which refuses every request unless
# this is set — the endpoint runs work for every tenant, so an unauthenticated
# one is a way for anyone to make this deployment fetch arbitrary URLs and
# spend its model budget. Vercel Cron sends it as a bearer token automatically
# once the variable exists on the project. Generate one with:
#
#   openssl rand -hex 32
#
# Without it, nothing scans on a timer and the sources screen says so.
CRON_SECRET=

# Optional. When BOTH are set, /api/inngest serves the same tick on Inngest's
# schedule and retry semantics instead of Vercel Cron. One without the other is
# a half-wired integration that fails at the first invocation, so the app
# treats either-alone as not configured.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Providers ───────────────────────────────────────────────────────────
#
# Contact discovery. Optional: with no key the `enrich_person` job reports
# that it is not configured and stops, rather than guessing
# first.last@company.com and presenting it as a finding — a guessed address is
# a plausible string with no evidence behind it, and the bounce lands on the
# customer's sending domain.
#
# There is deliberately no ENRICHMENT_PROVIDER variable. The vendor is chosen
# from the shape of the key (Hunter keys are 40 characters or prefixed
# `hunter_`; anything else is treated as Apollo), because a second variable
# that has to agree with the first is a misconfiguration waiting to happen —
# the failure being a live deployment sending one vendor's key to another's
# endpoint and reporting "no results" rather than "wrong credentials".
ENRICHMENT_API_KEY=

# Email verification (ZeroBounce). Optional. Unset means every address is
# stored `unverified` and the outreach screen says so — rather than a green
# tick the deployment did not earn.
EMAIL_VERIFICATION_API_KEY=

# ── Observability ───────────────────────────────────────────────────────
# Error reporting. Both are optional: with no DSN the SDK initialises as a
# no-op, which is the normal state locally and in CI.
#
# The two DSNs are usually the same value. They are separate variables because
# only the NEXT_PUBLIC_ one is compiled into the browser bundle, and keeping
# the names distinct makes an accidental swap visible.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload at build time. Only needed in the deploy environment; all
# three must be set or upload is skipped (see apps/web/next.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics. Optional: with no key, `capture()` is a no-op, which is
# the normal state locally and in CI.
#
# Events are sent from the SERVER (`posthog-node`), not the browser — see
# apps/web/lib/analytics.ts for why, and for the list of things deliberately
# never sent. The variable keeps its NEXT_PUBLIC_ prefix because the key is a
# public write-only project key and renaming it would break existing
# deployments for no gain.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com. Set it for US or self-hosted.
NEXT_PUBLIC_POSTHOG_HOST=

# ── Company & contact data provider ────────────────────────────────────────
#
# Apollo serves four capabilities: company.search, company.enrich,
# person.search and person.match. Without it the product still works — sources
# still produce signals, qualification still runs — but `discover_companies`
# has nothing to search with, so an ICP describing four thousand addressable
# companies produces none of them until one appears in a feed.
#
# It is also what the onboarding reach counter calls. With no key that counter
# says "no company-search provider is connected" rather than showing a zero,
# because "0 companies match your profile" and "we cannot count" are opposite
# statements and only one of them is true.
#
# See packages/providers/src/registry.ts for how capabilities are routed when
# several vendors are configured.
APOLLO_API_KEY=

# ── Anonymous research on the landing page ─────────────────────────────────
#
# The landing page's primary call to action is a domain box: a visitor types
# their company's address and Huntloop reads the site before they have an
# account. That puts an Opus call with web fetching behind an unauthenticated
# endpoint, which is the single most expensive misconfiguration available in
# this codebase — so it is OFF unless this is exactly "true".
#
# Leaving it off is a supported state, not a degraded one: the /discover page
# says "create a free account and we'll read yours right away" and the funnel
# continues through signup.
PUBLIC_RESEARCH_ENABLED=

# The whole endpoint's ceiling for a rolling 24 hours. Defaults to 200.
#
# This is the control that actually bounds the bill. A per-IP window is also
# enforced (5/hour) and a distributed script defeats that trivially; nothing
# defeats a hard daily cap. Set it deliberately before enabling the feature —
# 0 switches the endpoint off entirely.
PUBLIC_RESEARCH_DAILY_LIMIT=

# Salt for the per-source rate-limit hash.
#
# Visitor addresses are hashed rather than stored: the question being answered
# is "is one source hammering us", which a hash answers exactly as well, and an
# `inet` column here would be personal data about people who never became
# customers. The salt stops the (small) IPv4 space being brute-forced and makes
# hashes non-comparable across deployments. Optional — unset weakens the
# anonymity, never the rate limiting.
PUBLIC_RESEARCH_SALT=

# ── Platform-provided (do not set by hand) ──────────────────────────────
# Set by Vercel on every deployment; /api/health reports the serving commit.
VERCEL_GIT_COMMIT_SHA=

# ── Development only ────────────────────────────────────────────────────
# Set to 0 to see the onboarding ICP gate as production enforces it. Ignored by
# production builds, where the bypass is compiled out.
NEXT_PUBLIC_HUNTLOOP_DEV_BYPASS=

# Copy to apps/web/.env.local and fill in. Never commit the filled version.

# ── Supabase ────────────────────────────────────────────────────────────
# Project ref: hnoycsbdddpmsivtmrws
# Current-generation key names (Supabase's publishable/secret system,
# successor to the legacy anon/service_role JWTs).
NEXT_PUBLIC_SUPABASE_URL=https://hnoycsbdddpmsivtmrws.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with
# NEXT_PUBLIC_. Used exclusively by packages/db/src/admin.ts (plan §D2).
SUPABASE_SECRET_KEY=

# Direct Postgres connection, for Drizzle migrations/schema push — separate
# from the two keys above. Supabase dashboard → Project Settings → Database
# → Connection string ("Transaction" pooler mode for serverless/Vercel).
DATABASE_URL=

# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Mailbox OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Jobs ────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Providers ───────────────────────────────────────────────────────────
ENRICHMENT_API_KEY=
EMAIL_VERIFICATION_API_KEY=

# ── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

{
  "name": "huntloop",
  "private": true,
  "version": "0.1.0",
  "author": "Chandra Mani Sharma",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @huntloop/web",
    "build": "npm run build --workspace @huntloop/web",
    "start": "npm run start --workspace @huntloop/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "db:doctor": "npm run doctor --workspace @huntloop/db --",
    "db:seed": "npm run seed --workspace @huntloop/db --",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "audit:site": "node scripts/audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:site && npm run build && npm run audit:bundle",
    "audit:bundle": "node scripts/bundle-budget.mjs",
    "live-check": "node --experimental-strip-types scripts/live-check.ts",
    "load:rate-limit": "node scripts/load-rate-limit.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.47.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.62.1",
    "typescript-eslint": "^8.67.0"
  }
}

{
  "name": "@huntloop/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:migrations && npm run check:admin-imports",
    "test:migrations": "node --experimental-strip-types scripts/verify-migrations.ts",
    "check:admin-imports": "node --experimental-strip-types scripts/check-admin-imports.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

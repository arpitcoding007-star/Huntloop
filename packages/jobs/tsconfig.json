{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for one line in @huntloop/db: admin.ts checks `typeof window`
    // before handing out a service-role client, which is defence in depth behind
    // the import check. Without the lib that guard is a type error in this
    // package, and deleting the guard to satisfy a compiler is the wrong way
    // round.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Relative imports in this package carry the `.ts` extension. That is not a
    // style choice: `npm test` runs the task suite through Node's type
    // stripping, and Node's ESM resolver requires a real filename. Webpack
    // resolves the same specifier to the same file, so the app is unaffected.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
